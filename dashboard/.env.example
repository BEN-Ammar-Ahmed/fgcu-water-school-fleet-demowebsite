# Copy this file to ".env" (same folder) and paste your Supabase connection string below.
# Supabase > your project > Connect (top bar) > "Session pooler" > URI.
# Replace [YOUR-PASSWORD] with your database password. Never commit the .env file.
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Keeps people signed in when the site restarts. Any long random text; make your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
RESERVE_SECRET_KEY=

# Optional (see README.md): addresses of the two sites, real email sending, a contact address
# FLEET_URL=http://localhost:5000
# RESERVE_URL=http://localhost:5001
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  MAIL_FROM=  MAIL_REPLY_TO=
# FLEET_CONTACT_EMAIL=

# The logo (optional). Put the official file from FGCU University Marketing in dashboard/static/ and name it here.
# LOGO_WIDE=1 for a wide logo that already has the words in it (then the text next to the logo is hidden).
# LOGO_FILE=fgcu-water-school.svg
# LOGO_WIDE=1
